diff --git a/src/WallpaperEngine/Application/PauseControl.h b/src/WallpaperEngine/Application/PauseControl.h
new file mode 100644
index 0000000..2442912
--- /dev/null
+++ b/src/WallpaperEngine/Application/PauseControl.h
@@ -0,0 +1,27 @@
+// Wallweave cooperative pause adapter. Do not suspend an audio client process.
+#pragma once
+#include <ctime>
+#include <filesystem>
+#include <fcntl.h>
+#include <string_view>
+#include <sys/stat.h>
+#include <unistd.h>
+
+namespace WallpaperEngine::Application {
+inline bool readPauseControl (const std::filesystem::path& path) {
+    // Nonblocking even if a bad path names a FIFO. Bound all reads and fail open.
+    const int fd = open (path.c_str (), O_RDONLY | O_NONBLOCK | O_CLOEXEC);
+    if (fd < 0) {
+        return false;
+    }
+    struct stat info {};
+    char value[6] {};
+    const auto now = std::time (nullptr);
+    const bool paused = fstat (fd, &info) == 0 && S_ISREG (info.st_mode)
+        && info.st_size == sizeof (value) && now >= info.st_mtime && now - info.st_mtime < 3
+        && read (fd, value, sizeof (value)) == sizeof (value)
+        && std::string_view (value, sizeof (value)) == "pause\n";
+    close (fd);
+    return paused;
+}
+}
