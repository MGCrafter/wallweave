# Generated for the release by scripts/package-linux.py.
pkgname=wallweave
pkgver=@VERSION@
pkgrel=1
pkgdesc='Native Linux desktop app for existing Wallpaper Engine libraries'
arch=('x86_64')
url='https://github.com/MGCrafter/wallweave'
license=('MIT' 'ISC' 'OFL-1.1' 'LicenseRef-Valve-Steamworks')
depends=('glibc>=2.35' 'gcc-libs' 'libxkbcommon' 'wayland' 'libglvnd' 'libx11' 'libxcursor' 'libxi' 'libxrandr' 'dbus')
optdepends=('steam: Workshop browsing and downloads'
            'python: optional renderer installer'
            'xdg-desktop-portal: native file picker'
            'xdg-desktop-portal-gtk: GTK portal backend if your desktop has no other backend')
options=('!strip' '!debug')
source=("https://github.com/MGCrafter/wallweave/releases/download/v${pkgver}/wallweave-${pkgver}-linux-x86_64.tar.gz")
sha256sums=('@ARCHIVE_SHA256@')

package() {
    cd "wallweave-${pkgver}-linux-x86_64"
    install -Dm755 bin/wallweave "${pkgdir}/usr/lib/wallweave/bin/wallweave"
    install -Dm755 bin/libsteam_api.so "${pkgdir}/usr/lib/wallweave/bin/libsteam_api.so"
    install -Dm755 run.sh "${pkgdir}/usr/lib/wallweave/run.sh"
    install -d "${pkgdir}/usr/bin"
    printf '%s\n' '#!/bin/sh' 'exec /usr/lib/wallweave/run.sh "$@"' > "${pkgdir}/usr/bin/wallweave"
    chmod 755 "${pkgdir}/usr/bin/wallweave"
    install -Dm644 packaging/io.wallweave.Wallweave.desktop "${pkgdir}/usr/share/applications/io.wallweave.Wallweave.desktop"
    install -Dm644 packaging/io.wallweave.Wallweave.svg "${pkgdir}/usr/share/icons/hicolor/scalable/apps/io.wallweave.Wallweave.svg"
    install -Dm644 scripts/install-renderer.py "${pkgdir}/usr/share/wallweave/install-renderer.py"
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/wallweave/LICENSE"
    cp -r licenses/. "${pkgdir}/usr/share/licenses/wallweave/"
    install -d "${pkgdir}/usr/share/doc/wallweave" "${pkgdir}/usr/share/wallweave/examples"
    cp -r docs/. "${pkgdir}/usr/share/doc/wallweave/"
    cp -r examples/. "${pkgdir}/usr/share/wallweave/examples/"
}
